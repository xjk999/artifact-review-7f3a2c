    "diffusion_steps": 1000,
    "sampling_steps": 1000,
    "sampler": "ddpm",
    "clip_denoised": true,
    "ncct_hu": [0.0, 200.0],
    "cta_hu": [0.0, 800.0],
    "roi_margin": 16,
    "tile_overlap": 0.25,
    "case_aggregation": "max"
