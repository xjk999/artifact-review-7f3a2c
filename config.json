{
  "segmentation_checkpoint": "weights/segmentation_final.pt",
  "diffusion_checkpoint": "weights/generation_final.pt",
  "detection_checkpoint": "weights/detection_final.pt",
  "device": "cuda:0",
  "seed": 42,
  "threshold": 0.65,
  "training": {
    "mode": "final",
    "segmentation": {
      "epochs": 300,
      "save_every": 1,
      "batch_size": 1,
      "num_workers": 0,
      "optimizer": "AdamW",
      "learning_rate": 0.0002,
      "weight_decay": 0.00001,
      "betas": [0.9, 0.999],
      "eps": 0.00000001,
      "scheduler": "cosine",
      "min_learning_rate": 0.0,
      "loss": "DiceCE",
      "dice_weight": 1.0,
      "ce_weight": 1.0,
      "include_background": true,
      "smooth_nr": 0.00001,
      "smooth_dr": 0.00001,
      "crop_positive": 2,
      "crop_negative": 1,
      "samples_per_case": 1,
      "image_threshold": 0.1,
      "flip_probabilities": [0.2, 0.2, 0.0],
      "intensity_shift_probability": 0.2,
      "intensity_shift_offset": 0.05
    },
    "generation": {
      "steps": 400000,
      "save_every": 5000,
      "log_every": 100,
      "batch_size": 1,
      "optimizer": "AdamW",
      "learning_rate": 0.00001,
      "weight_decay": 0.0,
      "betas": [0.9, 0.999],
      "eps": 0.00000001,
      "loss": "MSE",
      "flip_probabilities": [0.2, 0.2, 0.2],
      "initial_checkpoint": null
    },
    "detection": {
      "steps": 15000,
      "save_every": 5000,
      "log_every": 100,
      "batch_size": 1,
      "optimizer": "AdamW",
      "learning_rate": 0.00001,
      "weight_decay": 0.0,
      "betas": [0.9, 0.999],
      "eps": 0.00000001,
      "loss": "BCE",
      "initial_checkpoint": null
    }
  },
  "segmentation": {
    "spacing": [1.0, 1.0, 1.0],
    "intensity_min": -150.0,
    "intensity_max": 250.0,
    "init_filters": 16,
